# 首次启动写入数据库。更改本文件不会重置既有管理员密码。
CAMMON_ADMIN_USERNAME=admin
CAMMON_ADMIN_PASSWORD=replace-with-your-own-long-password
CAMMON_PORT=18080
# 本地构建默认镜像；使用 CI 发布的镜像时改为 ghcr.io/hsyhhssyy/cammon:版本号。
CAMMON_IMAGE=cammon:0.1.4
# 元数据、配置、索引和同步队列只保留在内存中。
# 新增录像使用容器临时 /cache；Samba 运行文件使用 /run/cammon 的 tmpfs。
CAMMON_CACHE_LIMIT_BYTES=10737418240
CAMMON_CACHE_RESERVE_BYTES=67108864
CAMMON_SUCCESSOR_QUIET_SECONDS=10
CAMMON_IDLE_SEAL_SECONDS=1800
CAMMON_ALLOW_NTLMV1=false
CAMMON_FFMPEG_THREADS=2
CAMMON_BUILD_JOBS=2
# PostgreSQL 必须在启动时可用；启动后断线继续使用内存配置。
# 密码中的特殊字符须做 URL 编码，部署前替换下面的示例。
CAMMON_POSTGRES_DSN=postgresql://cammon:encoded-password@192.168.1.20:5432/cammon?sslmode=require
# 用 .venv/bin/python -c 'from cryptography.fernet import Fernet; print(Fernet.generate_key().decode())' 生成。
# 跨重启保持这个值，用来解密 PostgreSQL 中保存的凭据。部署前替换。
CAMMON_SECRET_KEY=replace-with-a-generated-fernet-key
CAMMON_POSTGRES_SCHEMA=cammon
CAMMON_METADATA_SYNC_SECONDS=5
