# 复制为 .env，填写下面三个必填项；不要把填写后的 .env 提交到仓库。
CAMMON_IMAGE=ghcr.io/hsyhhssyy/cammon:latest
# 私有镜像须先 docker login ghcr.io，使用可读取此包的 GitHub classic PAT。
# 正式部署也可指定版本，例如 ghcr.io/hsyhhssyy/cammon:0.1.0。
CAMMON_ADMIN_USERNAME=admin
# 必填，至少 12 字符；首次启动保存密码哈希到 PostgreSQL。
CAMMON_ADMIN_PASSWORD=
CAMMON_PORT=18080

# 必填，指向已有的 PostgreSQL 数据库。密码中的特殊字符须 URL 编码。
# 示例：postgresql://cammon:encoded-password@192.168.1.20:5432/cammon?sslmode=require
# PostgreSQL 须在启动时可用；运行中断线继续使用内存配置。
CAMMON_POSTGRES_DSN=
# 必填，Fernet 密钥。用 README 中的一次性 docker run 命令生成。
# 重启或更新镜像时须保持相同，才能解密数据库中的凭据。
CAMMON_SECRET_KEY=
CAMMON_POSTGRES_SCHEMA=cammon
CAMMON_METADATA_SYNC_SECONDS=5

# 元数据与待同步变更只放内存，Samba 运行文件用 tmpfs。
# /cache 仅存新增录像和转码临时视频，不绑定持久化目录，重启允许丢失。
CAMMON_CACHE_LIMIT_BYTES=10737418240
CAMMON_CACHE_RESERVE_BYTES=67108864
CAMMON_SUCCESSOR_QUIET_SECONDS=10
CAMMON_IDLE_SEAL_SECONDS=1800
CAMMON_FFMPEG_THREADS=2
# 仅在摄像机无法使用 NTLMv2 时调整。
CAMMON_ALLOW_NTLMV1=false
